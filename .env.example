# Provider API keys are entered on the Settings page and stored by relay-vault.
# Never put provider credentials in VITE_* variables: Vite bundles those values.
#
# Runtime-only names for the Docker test container (see docker-compose.test.yml
# and .env.test.local). The server seeds them into the per-user relay vault.
# CIVITAI_API_KEY=
# FAL_KEY=
# GROK_RELAY_API_KEY=
# GROK_RELAY_BASE_URL=http://sub.alibb123.ccwu.cc/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://birdsun.click/v1
